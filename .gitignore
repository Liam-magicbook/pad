# ---- Runtime data: never commit ----
/data/
*.db
*.db-wal
*.db-shm
artifacts/
input_files/
input_images/
work/
logs/
*.log

# ---- Machine-private: node configs hold real hostnames/paths/keys, each person keeps their own ----
ld_config.yaml
ld_config.*.yaml
!ld_config.example.yaml
!ld_config.node.yaml.example
.pad_key
pad.env
setup-env.sh
*.bak-*
*.bak
# Private pipeline scripts (baked capabilities that only run on your own machine); kept out of the repo along with ld_config
harness/run_*.local.py
harness/run_daily.py
harness/pipelines/

# ---- Python ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.so
.python-version
build/
dist/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ---- Editors / OS ----
.DS_Store
.idea/
.vscode/
*.swp
.tmp/

# Fallback output of the demo-image script (leaves HTML behind when webshot is missing)
docs/preview/*.html

# ---- Paper: raw scrapes contain the operator's real goal text and task ids, commit aggregates only ----
paper/data/tasks.json
!paper/data/aggregates.json

# LaTeX intermediates
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.bcf
paper/*.run.xml
paper/*.synctex.gz

# Intermediates of the demo-image script
docs/preview/.scene-*.html

# ---- Paper sources are not committed (only pad.pdf + aggregate data are published) ----
paper/*.tex
paper/*.bib
paper/*.bbl
paper/*.sty
paper/*.bst
