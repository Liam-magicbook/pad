# Linux daemon (systemd). Change User / WorkingDirectory, then:
#   sudo cp deploy/pad-node.service /etc/systemd/system/pad-ld.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now pad-ld
[Unit]
Description=PAD node agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/opt/pad-ld
ExecStart=/opt/pad-ld/.venv/bin/python -u /opt/pad-ld/ld_agent.py /opt/pad-ld/ld_config.yaml
Restart=always
RestartSec=10
Environment=HOME=/home/CHANGE_ME
# The keep-alive PATH is very narrow; list the executor CLI directories explicitly (otherwise
# tasks fail to start)
Environment=PATH=/home/CHANGE_ME/.opencode/bin:/home/CHANGE_ME/.local/bin:/home/CHANGE_ME/.npm-global/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
