# Node config sample — copy to ld_config.yaml and change three places:
#   node_id / capabilities / pad_url
#
# Naming convention (see JOIN.md section 2):
#   with a machine-name prefix = this machine only, other machines must not declare it  -> gpu-1.build
#   without a prefix           = describes "what it does", anyone may declare it and share the load -> scrape.batch
#
# Ask before declaring: will two machines doing this at once step on each other? If yes -> only one declares it.
#
# Concurrency (concurrency, default 1 = serial):
#   A single node can now run several tasks at once. Add concurrency: N to a capability and it
#   has N slots; LD keeps claiming work to fill them (each task gets its own executor process).
#   Only add it when "these jobs truly do not collide in parallel": anything needing an account
#   login, writing the same file, or competing for the same resource (e.g. the whole daily
#   pipeline) stays at 1.

node_id: CHANGE_ME            # e.g. gpu-1 / vps-1, globally unique
role: compute                 # compute / publisher / anything custom
description: "一句话说清这台机器干嘛。要写明有没有账号登录态。"
workspace: ~/pad-workspace    # working root for agent-type tasks (passed down as PAD_WORKSPACE)

capabilities:

  # Example 1: deterministic job, call the script directly (it writes stdout itself, or append a tail)
  # publish.blog:
  #   desc: "发博客"
  #   cmd: "cd ~/projects/blog && bash publish.sh"
  #   timeout_min: 120

  # Example 2: a job needing judgement, handed to the local agent headless (machine-specific, prefixed name)
  gpu-1.build:
    desc: "跑重型代码任务"
    cmd: "python3 /opt/pad-ld/harness/run_harness.py opencode"
    timeout_min: 240
    concurrency: 2        # at most 2 on this machine at once; default 1 = serial. Only for jobs "confirmed safe in parallel"

  # Example 3: scraping
  scrape.batch:
    desc: "批量抓数据，只读，不改任何东西"
    cmd: "cd ~/projects/scraper && python3 crawl.py --out $PAD_WORK_DIR/data.json"
    timeout_min: 120

  # Self-check: the name is prefixed too, because "this machine is still alive" is machine-specific.
  # Wrapped in run_script.py: it folds stdout and the exit code into a standard result.json
  # (including per-item acceptance evidence). Plain echo works too, but then the server marks
  # "acceptance unanswered".
  NODE-1.ping.self:
    desc: "连通性自检"
    cmd: "python3 /opt/pad-ld/harness/run_script.py 'echo \"pong from $(hostname -s)\"'"
    timeout_min: 1

# ${PAD_KEY} is substituted from the environment or ~/.pad_key.
# Point host at your own PAD address (http://127.0.0.1:8790 locally).
pad_url: "http://127.0.0.1:8790/pad/${PAD_KEY}"
poll_sec: 20
work_dir: "~/pad-work"        # task work dir; the executor only writes here
